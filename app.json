{
  "expo": {
    "name": "Barricade", "slug": "emo-barricade", "version": "1.0.1", "runtimeVersion": "1.0.1",
    "scheme": "emobarricade", "orientation": "portrait", "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.thulanesigasa.emobarricade" },
    "android": {
      "package": "com.thulanesigasa.emobarricade", "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#000000" }
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 280, "resizeMode": "contain", "backgroundColor": "#000000" }]],
    "updates": { "checkAutomatically": "ON_LOAD", "fallbackToCacheTimeout": 0 },
    "extra": {}
  }
}
