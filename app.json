{
  "expo": {
    "name": "Barricade",
    "slug": "emo-barricade",
    "version": "1.0.2",
    "runtimeVersion": "1.0.1",
    "scheme": "emobarricade",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thulanesigasa.emobarricade"
    },
    "android": {
      "package": "com.thulanesigasa.emobarricade",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "./plugins/with-small-launcher.cjs"
    ],
    "updates": {
      "url": "https://u.expo.dev/e35ad141-7ddb-44a3-81b3-6f46fd3814df",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production-1.0.1"
      }
    },
    "extra": {
      "eas": {
        "projectId": "e35ad141-7ddb-44a3-81b3-6f46fd3814df"
      }
    }
  }
}
